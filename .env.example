# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Directories to watch (colon-separated)
MONITOR_DIRECTORIES=/home:/tmp

# Trusted IPs that should not trigger network alerts (comma-separated)
TRUSTED_IPS=127.0.0.1,192.168.1.1

# Path for the detection log file
LOG_FILE=keylogger_detection.log

# Email alert settings (SMTP)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
FROM_EMAIL=your_email@example.com
EMAIL_PASSWORD=your_password
TO_EMAIL=admin@example.com

# Twilio SMS settings
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567
TWILIO_TO_NUMBER=+15557654321
